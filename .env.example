# Copy to .env and adjust if not using the default docker-compose services.

DATABASE_URL=postgres://points_search:points_search@localhost:5432/points_search
REDIS_URL=redis://localhost:6379

# scraper-worker only
SCRAPE_CONCURRENCY=1
SCRAPE_HEADLESS=true
SCRAPE_MIN_DELAY_MS=4000
SCRAPE_JITTER_MS=4000
SCRAPE_CACHE_TTL_MINUTES=15
# Only needed if Playwright's default browser download/lookup doesn't apply
# (e.g. a Docker image with a pinned Chromium binary).
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chromium
